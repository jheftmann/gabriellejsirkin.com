# Sanity CMS — set these in Netlify environment variables to switch the build
# from markdown files to Sanity content. Leave unset to keep using markdown.
#
# Get these from sanity.io/manage after creating a project.
SANITY_PROJECT_ID=t4atn37a
SANITY_DATASET=production
SANITY_API_TOKEN=your_read_token_here

# Controls which content is fetched. Set automatically by netlify.toml:
#   production context → publishedOnly
#   branch-deploy context → previewDrafts
# Override manually if needed:
# SANITY_API_PERSPECTIVE=publishedOnly
